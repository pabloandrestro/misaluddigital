    {
      "name": "Documentos - Download View",
      "item": [
        {
          "name": "Descargar documento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"respuesta success con download_url\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"success\");",
                  "    pm.expect(json.download_url).to.be.a(\"string\");",
                  "    pm.expect(json.download_url.length).to.be.greaterThan(10);",
                  "    pm.expect(json.expires_in).to.eql(300);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/documents/{{document_id}}/download/?email={{test_email}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "documents",
                "{{document_id}}",
                "download",
                ""
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{test_email}}"
                }
              ]
            }
          }
        },
        {
          "name": "Visualizar documento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"respuesta success con view_url y mime_type\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(\"success\");",
                  "    pm.expect(json.view_url).to.be.a(\"string\");",
                  "    pm.expect(json.view_url.length).to.be.greaterThan(10);",
                  "    pm.expect(json.mime_type).to.be.a(\"string\");",
                  "    pm.expect(json.expires_in).to.eql(300);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/documents/{{document_id}}/view/?email={{test_email}}",
              "host": [
