    {
      "name": "Sharing",
      "item": [
        {
          "name": "01 - Create share link valid",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Share exists', function () {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.status).to.eql('success');",
                  "    pm.expect(j).to.have.property('share');",
                  "    pm.expect(j.share.token).to.be.a('string');",
                  "});",
                  "const j = pm.response.json();",
                  "if (j.share && j.share.token) { pm.collectionVariables.set('share_token', j.share.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"professional_name\": \"Dr. Juan Perez\",\n  \"professional_rut\": \"12345678-5\",\n  \"document_ids\": [\"{{document_id}}\"],\n  \"expires_in_hours\": 24\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/sharing/?email={{test_email}}",
              "host": ["{{base_url}}"],
              "path": ["api", "sharing", ""],
              "query": [{ "key": "email", "value": "{{test_email}}" }]
            }
          }
        },
        {
          "name": "02 - Create share link without expires_in_hours (default 24)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Share exists with expires_at', function () {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j.status).to.eql('success');",
                  "    pm.expect(j.share).to.have.property('expires_at');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"professional_name\": \"Dr. Juan Perez\",\n  \"professional_rut\": \"12345678-5\",\n  \"document_ids\": [\"{{document_id}}\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/sharing/?email={{test_email}}",
              "host": ["{{base_url}}"],
              "path": ["api", "sharing", ""],
              "query": [{ "key": "email", "value": "{{test_email}}" }]
            },
            "description": "Sin expires_in_hours: el serializer usa default=24 (ShareDocumentSerializer)."
          }
        },
